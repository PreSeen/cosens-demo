export type MemoryStatus = 'none' | 'running' | 'done' | 'failed';
export type MethodStatus = 'none' | 'partial' | 'ready' | 'running' | 'done' | 'failed';
export type Stage = { memory: MemoryStatus; method: MethodStatus; bp: boolean; analyzed: boolean; given: number; next: GroupId | null; ready: boolean };
export type HeroView = { prompt: string; sub: string; cur: number; spinning: boolean };
export type Check = { ok: boolean; hint: string };
export type Chip = { text: string; on: boolean };
export type MemoryFileView = { key: string; name: string; label: string; state: 'pending' | 'committed' | 'failed'; error: string | null; source: 'demo' | 'upload' };
export type MemoryView = { status: MemoryStatus; files: MemoryFileView[]; total: number; committed: number; failed: number; pending: number; title: string; percent: number; stats: { people: number; organizations: number; relations: number } | null; statsPanel: 'values' | 'pending' | 'none' };
export type PhaseView = { label: string; state: '' | 'run' | 'ok' | 'err' };
export type ProjectView = { slot: Slot; title: string; heading: string; status: Project['status']; label: string; progress: number; phases: PhaseView[]; error: string | null; bp: string | null; proposal: string | null };
export type SlotGuess = { slot: Slot | null; role: Role | null };
export type AssignRow = { name: string; slot: Slot | null; role: Role | null };
export type FileVerdict = { ok: boolean; kind: 'text' | 'document' | null; code: string | null; message: string };
export type SourceView = { title: string; verified: boolean };
export type PersonView = { name: string; initial: string; tag: { text: string; tone: 'ok' | 'warn' | 'blue' }; line: string; why: string; sources: SourceView[] };
export type ReportView = {
  heroTitle: string; note: string;
  verdict: { title: string; text: string };
  topQuestion: { title: string; text: string; sources: SourceView[] };
  experts: PersonView[]; expertGap: string; people: PersonView[]; peopleGap: string;
  queries: { query: string; titles: string[] }[]; unverified: number;
};
export type LiveRow = { text: string; find: string; state: 'run' | 'ok'; query: string | null };
export type LiveState = { rows: LiveRow[] };

